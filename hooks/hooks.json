{
  "description": "zcode-trae-connect lifecycle hooks",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/service-ensure.mjs"],
            "timeoutMs": 90000,
            "statusMessage": "Ensuring the Trae gateway endpoints (:19960/:19961) are up"
          }
        ]
      }
    ]
  }
}
