# trae2api 配置示例。复制为 .env 后按需修改（.env 已被 git-ignore）。

# ---- 服务 ----
PORT=19950
# 客户端需携带的 Bearer key
API_KEY=sk-trae2api-local
WORKSPACE_DIR=./output
LOG_LEVEL=info

# ---- 上游区域 ----
# cn = 国内版；sg = 国际版。
# 留空 = 自动：网关从载入的凭证判断区域；当池里同时存在两个区域的账号时，
#        还会按请求的模型名自动选区域（用错区域的模型名会得到 4001）。
# 显式设置则固定到一个区域，关闭按请求路由。
# TRAE_REALM=cn

# 数据目录：留空则自动探测 %APPDATA% 下的 Trae 客户端目录。
# TRAE_DATA_DIR=

# solo = TRAE SOLO（推荐，排队轻）；trae = 经典 Trae（chat_v3 排队重）
TRAE_PRODUCT=solo

# ---- 账号池 ----
# 成员目录（account-<userId>.json，含明文 token）。自定义时务必确保该目录被 git-ignore。
# TRAE_POOL_DIR=./accounts

# 是否允许网关自行刷新令牌：
#  off（推荐）= 只用已导入的令牌；令牌靠客户端重新登录更新（热导入自动接上）。
#               可避免 ExchangeToken 轮换令牌族、把同账号在其它客户端的登录踢掉。
#  on          = 允许网关自行续期（会轮换令牌族）。
TRAE_POOL_SELF_RENEW=off
# 单账号模式下的手动令牌（一般不使用）
# TRAE_MANUAL_TOKEN=

# ---- 自动续写 ----
# 模型只输出思考、或输出被截断时，自动再请求一轮补全（OpenAI + Anthropic 均支持）
AUTO_CONTINUE=true
MAX_CONTINUES=10

# ---- 推理深度控制 ----
# 总开关：false 可完全关闭前缀注入，退回模型原生默认行为
THINK_EFFORT_INJECTION=true
# 默认档位（请求体/会话未指定时生效）：auto | off | low | high | max
# auto = 不强制注入（推荐基线）
THINK_EFFORT=auto

# ---- 高级覆盖（一般无需设置）----
# 以下变量会**覆盖**区域配置表（src/realms.js）中的自动取值，设置后请自行保证配套正确。
# TRAE_HOST_CN=https://trae-api-cn.mchost.guru
# TRAE_AUTH_HOST_CN=https://api.trae.cn
# TRAE_HOST_SG=https://coresg-normal.trae.ai
# TRAE_AUTH_HOST_SG=https://growsg-normal.trae.ai
# TRAE_API_HOST=
# TRAE_AUTH_HOST=
# TRAE_IDE_VERSION=
# TRAE_IDE_VERSION_CODE=
# TRAE_DEVICE_ID=
# TRAE_MACHINE_ID=
# TRAE_APP_ID=6eefa01c-1036-4c7e-9ca5-d891f63bfcd8
# TRAE_OAUTH_CLIENT_ID=
# TRAE_OAUTH_CLIENT_SECRET=-
# TRAE_DEVICE_MODEL=83DG
# TRAE_OS_VERSION=Windows 11 Pro
# TRAE_SOLO_FUNCTION=solo_work_lite
# TRAE_AUTO_FUNCTION=inline_chat

# ---- 代理 ----
# HTTP_PROXY=
# HTTPS_PROXY=
# ALL_PROXY=
