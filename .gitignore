# Dependencies
node_modules/
__pycache__/
*.pyc

# Environment & secrets
.env
.env.local
.env.production
os-crypt-key.txt
**/os-crypt-key.txt
decrypted-*.json
test-*-request.json

# Account pool members (明文 token，等同账号本体，严禁入库)
accounts/*
!accounts/README.md

# History (不同步)
.history.md

# Logs
logs/

# Output & temp
output/
tmp-userdata/
**/tmp-userdata/
tmp-*.json
/tmp-*.json
captures/
*.har

# Test data & archive (探索/测试脚本不同步, but allow scripts/ and tests/ source files)
scripts/archive/
tests/data/
tests/results/

# Root-level temporary scripts and test data (use / prefix to limit to root only)
/_*.js
/_*.json
/test-*.json
/test_*.js
/bun.lock

# Python cache (not part of Node project)
__pycache__/
*.pyc

# Screenshots are in docs/screenshots/ now
/screenshots/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Data files (contain encrypted model params with account-bound credentials)
data/

# Local CodeGraph index
.codegraph/

# zcode-trae-connect local runtime artifacts (never publish)
instances/
sandbox/
**/.mimosa/
service.log
service.err.log
*.bak-before-*
